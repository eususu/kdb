# Meilisearch
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=replace-me

# Apache Tika (base URL, endpoint paths are appended by the server)
TIKA_URL=http://localhost:9998

# Server
PORT=3000

# Default index used when a request omits `index`
DEFAULT_INDEX=my_docs

# Chunking (characters)
#   pages shorter than MIN are merged into the following page
#   pages longer than MAX are split into overlapping windows
CHUNK_MIN_CHARS=80
CHUNK_MAX_CHARS=4000
CHUNK_OVERLAP_CHARS=200

# Upload limit in megabytes
MAX_UPLOAD_MB=50

# OCR fallback via an Ollama vision model.
# Pages Tika cannot read are rendered to PNG and transcribed by the model.
# Leave OLLAMA_URL empty to disable OCR entirely.
OLLAMA_URL=http://localhost:11434
OCR_ENABLED=true
# Must be a model with the "vision" capability (check /api/tags).
OCR_MODEL=qwen3.6:35b
# A page with fewer characters than this counts as "no text extracted".
# 1 = only fully empty pages. Raising this lets OCR also retry sparse pages, but a
# short valid page (a cover, a divider) may then be replaced by model output.
OCR_MIN_CHARS=1
# Render scale; 2 is roughly 144 DPI.
OCR_SCALE=2
# Inference costs ~10s per page, so cap how many pages one upload can trigger.
OCR_MAX_PAGES=20
OCR_TIMEOUT_MS=120000
OCR_CONCURRENCY=1
